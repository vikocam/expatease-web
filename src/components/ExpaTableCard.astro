---
// "Table card" for ExpaTable: a calendar-style tent card (VR = vrijdag) that sits
// on a top-down table drawing (round table + chairs). Used on the home band and
// on the spreekuur page hero.
interface Props {
  /** small line under the big VR, e.g. "middag" or "14:00-16:00" */
  when: string;
  /** optional second line, e.g. "Het Plein, Den Haag" */
  where?: string;
}
const { when, where } = Astro.props;
---
<div class="xt-visual" aria-hidden="true">
  <svg class="xt-table" viewBox="0 0 240 240" fill="none">
    <circle cx="120" cy="120" r="74" stroke="currentColor" stroke-width="1.5"/>
    <circle cx="120" cy="120" r="58" stroke="currentColor" stroke-width="1" opacity=".5"/>
    <g fill="currentColor">
      <circle cx="120" cy="24" r="11"/><circle cx="120" cy="216" r="11"/>
      <circle cx="24" cy="120" r="11"/><circle cx="216" cy="120" r="11"/>
      <circle cx="52" cy="52" r="11"/><circle cx="188" cy="188" r="11"/>
      <circle cx="188" cy="52" r="11"/><circle cx="52" cy="188" r="11"/>
    </g>
  </svg>
  <div class="xt-card">
    <span class="xt-card-top">Elke week</span>
    <span class="xt-day">VR</span>
    <span class="xt-when">{when}</span>
    {where && <span class="xt-where">{where}</span>}
  </div>
</div>

<style>
  .xt-visual{position:relative;width:min(300px,100%);aspect-ratio:1;display:grid;place-items:center;margin-inline:auto}
  @media (max-width:767px){.xt-visual{width:min(240px,100%)}}
  .xt-table{position:absolute;inset:0;width:100%;height:100%;color:var(--gold);opacity:.35}
  .xt-card{
    position:relative;display:flex;flex-direction:column;align-items:center;
    width:62%;padding:0 0 18px;border-radius:14px;overflow:hidden;
    background:#fbfaf7;color:var(--navy);text-align:center;
    box-shadow:0 26px 40px -22px rgba(4,16,36,.75);
    transform:rotate(-4deg);
  }
  .xt-card-top{
    display:block;width:100%;padding:8px 0;margin-bottom:6px;
    background:var(--gold);color:#1a1204;
    font-size:12px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;
  }
  .xt-day{font-family:'Fraunces',Georgia,serif;font-size:clamp(56px,7vw,76px);font-weight:600;line-height:1;letter-spacing:-.02em}
  .xt-when{margin-top:6px;font-size:15px;font-weight:600}
  .xt-where{margin-top:2px;font-size:13px;color:#4f5b6b}

  @media (prefers-reduced-motion: no-preference){
    .xt-card{transition:transform .6s cubic-bezier(.16,1,.3,1)}
    .xt-visual:hover .xt-card{transform:rotate(-1deg) translateY(-4px)}
    .xt-table{transition:transform 1.2s cubic-bezier(.16,1,.3,1)}
    .xt-visual:hover .xt-table{transform:rotate(12deg)}
  }
</style>
