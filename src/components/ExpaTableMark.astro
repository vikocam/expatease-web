---
// ExpaTable visual in the same language as the service cards:
// a small gold line icon (Phosphor light) and a large faint watermark of it.
import tableIcon from '@phosphor-icons/core/assets/light/users-three-light.svg?raw';
interface Props { part: 'icon' | 'mark'; }
const svg = tableIcon.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---
{Astro.props.part === 'icon'
  ? <span class="xt-icon" set:html={svg} />
  : <span class="xt-mark" set:html={svg} />}

<style>
  .xt-icon{display:block;width:48px;height:48px;color:var(--gold);margin-bottom:18px}
  .xt-mark{
    position:absolute;right:clamp(220px,25vw,360px);top:50%;width:min(380px,40vw);aspect-ratio:1;
    transform:translateY(-50%);color:#ffffff;opacity:.05;pointer-events:none;
  }
  @media (max-width:767px){.xt-mark{width:280px;right:-90px;top:auto;bottom:-60px;transform:none}}
  .xt-icon :global(svg),.xt-mark :global(svg){width:100%;height:100%;display:block}
  @media (prefers-reduced-motion: no-preference){
    .xt-mark{transition:transform 1.2s cubic-bezier(.16,1,.3,1)}
  }
</style>
