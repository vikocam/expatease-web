---
import { ui } from '../i18n/ui';
import { prefix, type Lang } from '../i18n';
import { SHOW_EXPATABLE } from '../config';
interface Props { lang?: Lang; }
const { lang = 'nl' } = Astro.props;
const base = prefix(lang);
const t = ui[lang].footer;
const nav = ui[lang].nav;
// Temporarily hidden: set to true to show them again.
const SHOW_SOCIAL = false;
const SHOW_HOURS = false;
---
<footer class="site">
  <div class="wrap">
    <div class={`footgrid${SHOW_HOURS ? '' : ' footgrid-3'}`}>
      <div>
        <h5>ExpatAid</h5>
        <p style="max-width:340px">{t.about}</p>
        {SHOW_SOCIAL && (
        <div class="social-links">
          <a href="https://www.linkedin.com/company/expataid" target="_blank" rel="noopener" aria-label={t.linkedin}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.56v-5.58c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.68H9.34V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56z"/></svg>
          </a>
          <a href="https://www.instagram.com/expataid" target="_blank" rel="noopener" aria-label={t.instagram}>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2c2.72 0 3.06.01 4.12.06 1.07.05 1.79.22 2.43.47.66.25 1.21.6 1.76 1.15.5.5.9 1.1 1.15 1.76.25.64.42 1.36.47 2.43.05 1.06.06 1.4.06 4.13s-.01 3.06-.06 4.12c-.05 1.07-.22 1.79-.47 2.43a4.9 4.9 0 0 1-1.15 1.76 4.9 4.9 0 0 1-1.76 1.15c-.64.25-1.36.42-2.43.47-1.06.05-1.4.06-4.12.06s-3.06-.01-4.13-.06c-1.07-.05-1.79-.22-2.43-.47a4.9 4.9 0 0 1-1.76-1.15 4.9 4.9 0 0 1-1.15-1.76c-.25-.64-.42-1.36-.47-2.43C2.01 15.06 2 14.72 2 12s.01-3.06.06-4.12c.05-1.07.22-1.79.47-2.43.25-.66.6-1.26 1.15-1.76a4.9 4.9 0 0 1 1.76-1.15c.64-.25 1.36-.42 2.43-.47C8.94 2.01 9.28 2 12 2zm0 1.8c-2.67 0-2.99.01-4.04.06-.87.04-1.34.18-1.65.3-.42.16-.71.35-1.02.66-.31.31-.5.6-.66 1.02-.12.31-.26.78-.3 1.65-.05 1.05-.06 1.37-.06 4.04s.01 2.99.06 4.04c.04.87.18 1.34.3 1.65.16.42.35.71.66 1.02.31.31.6.5 1.02.66.31.12.78.26 1.65.3 1.05.05 1.37.06 4.04.06s2.99-.01 4.04-.06c.87-.04 1.34-.18 1.65-.3.42-.16.71-.35 1.02-.66.31-.31.5-.6.66-1.02.12-.31.26-.78.3-1.65.05-1.05.06-1.37.06-4.04s-.01-2.99-.06-4.04c-.04-.87-.18-1.34-.3-1.65a2.76 2.76 0 0 0-.66-1.02 2.76 2.76 0 0 0-1.02-.66c-.31-.12-.78-.26-1.65-.3-1.05-.05-1.37-.06-4.04-.06zm0 3.5a4.7 4.7 0 1 1 0 9.4 4.7 4.7 0 0 1 0-9.4zm0 1.8a2.9 2.9 0 1 0 0 5.8 2.9 2.9 0 0 0 0-5.8zm5.98-1.98a1.1 1.1 0 1 1-2.2 0 1.1 1.1 0 0 1 2.2 0z"/></svg>
          </a>
        </div>
        )}
      </div>
      <div class="fline">
        <h5>{t.navTitle}</h5>
        <a href={`${base}/diensten/`}>{nav.diensten}</a>
        <a href={`${base}/over-ons/`}>{nav.overons}</a>
        {SHOW_EXPATABLE && <a href={`${base}/spreekuur/`}>{nav.spreekuur}</a>}
        <a href={`${base}/contact/`}>{nav.contact}</a>
      </div>
      <div class="fline">
        <h5>{t.legalTitle}</h5>
        <a href={`${base}/privacy/`}>{t.privacy}</a>
        <a href={`${base}/cookies/`}>{t.cookies}</a>
        <a href={`${base}/voorwaarden/`}>{t.terms}</a>
      </div>
      {SHOW_HOURS && (
      <div class="fline">
        <h5>{t.hoursTitle}</h5>
        {t.hours.filter((_, i) => SHOW_EXPATABLE || i !== 1).map((h) => <span>{h}</span>)}
      </div>
      )}
    </div>
    <div class="footbottom">
      <span>© {new Date().getFullYear()} ExpatAid. {t.rights}</span>
      <span>{t.ids}</span>
    </div>
  </div>
</footer>
<div class="mfloat">
  <a class="wa" href={`https://wa.me/31600000000?text=${encodeURIComponent(t.waText)}`} target="_blank" rel="noopener">WhatsApp</a>
  <a class="bk" href={`${base}/contact/`}>{t.mobileBook}</a>
</div>
