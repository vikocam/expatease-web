---
import LogoIcon from './LogoIcon.astro';

import { ui } from '../i18n/ui';
import { prefix, href, homeHref, type Lang } from '../i18n';
import { SHOW_EXPATABLE } from '../config';
interface Props {
  lang?: Lang;
  active?: 'diensten' | 'over-ons' | 'spreekuur' | 'blog' | 'contact' | '';
  /** page path without language prefix, so the switcher opens the same page in another language */
  path?: string;
}
const { lang = 'nl', active = '', path = '/' } = Astro.props;

const base = prefix(lang);
const t = { ...ui[lang].nav };
const switchTo = (l: Lang) => (path === '/' ? homeHref(l) : href(l, path));
const langList: Lang[] = ['nl', 'en', 'es', 'fr'];
const links = [
  { key: 'diensten', href: `${base}/diensten/`, label: t.diensten, show: true },
  { key: 'over-ons', href: `${base}/over-ons/`, label: t.overons, show: true },
  { key: 'spreekuur', href: `${base}/spreekuur/`, label: t.spreekuur, show: SHOW_EXPATABLE },
  { key: 'contact', href: `${base}/contact/`, label: t.contact, show: true },
].filter((l) => l.show);

---
<header class="site">
  <div class="wrap headrow">
    <a class="logo" href={homeHref(lang)}>
      <LogoIcon />
      <span>EXPATAID<small>{ui[lang].logoSub}</small></span>
    </a>
    <nav class="mainnav">
      {links.map((l) => <a href={l.href} class={active===l.key ? 'active' : ''}>{l.label}</a>)}
    </nav>
    <div class="headright">
      <div class="langsel">
        {langList.map((l) => (
          <a href={switchTo(l)} hreflang={l} lang={l} class={lang===l ? 'active' : ''} aria-current={lang===l ? 'true' : undefined}>{l.toUpperCase()}</a>
        ))}
      </div>
      <a class="btn btn-gold headcta" href={`${base}/contact/`} style="padding:10px 18px;font-size:13.5px">{t.cta}</a>
      <button class="menubtn" type="button" aria-expanded="false" aria-controls="mobilemenu">
        <span class="menubtn-bars" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="menubtn-text">{t.menu}</span>
      </button>
    </div>
  </div>

  <!-- menu for small screens: links, language and booking, opened by the Menu button -->
  <div class="mobilemenu" id="mobilemenu">
    <div class="wrap">
      <nav class="mm-nav" aria-label={t.menu}>
        {links.map((l) => <a href={l.href} class={active===l.key ? 'active' : ''} aria-current={active===l.key ? 'page' : undefined}>{l.label}</a>)}
      </nav>
      <p class="mm-label">{t.language}</p>
      <div class="mm-langs">
        {langList.map((l) => (
          <a href={switchTo(l)} hreflang={l} lang={l} class={lang===l ? 'active' : ''} aria-current={lang===l ? 'true' : undefined}>{l.toUpperCase()}</a>
        ))}
      </div>
      <a class="btn btn-gold mm-cta" href={`${base}/contact/`}>{t.cta}</a>
    </div>
  </div>
</header>

<script>
  (function () {
    const btn = document.querySelector<HTMLButtonElement>('.menubtn');
    const panel = document.getElementById('mobilemenu');
    if (!btn || !panel) return;
    const setOpen = (open: boolean) => {
      btn.setAttribute('aria-expanded', String(open));
      panel.classList.toggle('open', open);
      document.documentElement.classList.toggle('menu-open', open);
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
    panel.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setOpen(false); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && panel.classList.contains('open')) { setOpen(false); btn.focus(); }
    });
    matchMedia('(min-width: 881px)').addEventListener('change', (e) => { if (e.matches) setOpen(false); });
  })();
</script>
