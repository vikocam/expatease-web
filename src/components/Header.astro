---
import LogoIcon from './LogoIcon.astro';

import { ui } from '../i18n/ui';
import { prefix, href, homeHref, type Lang } from '../i18n';
import { SHOW_EXPATABLE } from '../config';
interface Props {
  lang?: Lang;
  active?: 'diensten' | 'over-ons' | 'spreekuur' | 'blog' | 'contact' | '';
  /** page path without language prefix, so the switcher opens the same page in another language */
  path?: string;
}
const { lang = 'nl', active = '', path = '/' } = Astro.props;

const base = prefix(lang);
const t = { ...ui[lang].nav };
const switchTo = (l: Lang) => (path === '/' ? homeHref(l) : href(l, path));

---
<header class="site">
  <div class="wrap headrow">
    <a class="logo" href={homeHref(lang)}>
      <LogoIcon />
      <span>EXPATAID<small>{ui[lang].logoSub}</small></span>
    </a>
    <nav class="mainnav">
      <a href={`${base}/diensten/`} class={active==='diensten' ? 'active' : ''}>{t.diensten}</a>
      <a href={`${base}/over-ons/`} class={active==='over-ons' ? 'active' : ''}>{t.overons}</a>
      {SHOW_EXPATABLE && <a href={`${base}/spreekuur/`} class={active==='spreekuur' ? 'active' : ''}>{t.spreekuur}</a>}
      <a href={`${base}/contact/`} class={active==='contact' ? 'active' : ''}>{t.contact}</a>
    </nav>
    <div class="headright">
      <div class="langsel">
        <a href={switchTo('nl')} hreflang="nl" lang="nl" class={lang==='nl' ? 'active' : ''} aria-current={lang==='nl' ? 'true' : undefined}>NL</a>
        <a href={switchTo('en')} hreflang="en" lang="en" class={lang==='en' ? 'active' : ''} aria-current={lang==='en' ? 'true' : undefined}>EN</a>
        <a href={switchTo('es')} hreflang="es" lang="es" class={lang==='es' ? 'active' : ''} aria-current={lang==='es' ? 'true' : undefined}>ES</a>
        <a href={switchTo('fr')} hreflang="fr" lang="fr" class={lang==='fr' ? 'active' : ''} aria-current={lang==='fr' ? 'true' : undefined}>FR</a>
      </div>
      <a class="btn btn-gold" href={`${base}/contact/`} style="padding:10px 18px;font-size:13.5px">{t.cta}</a>
    </div>
  </div>
</header>
