---
import { existsSync } from 'node:fs';
interface Props {
  title: string;
  subtitle: string;
  ctaPrimary: string;
  ctaSecondary: string;
  ctaSecondaryHref: string;
}
const { title, subtitle, ctaPrimary, ctaSecondary, ctaSecondaryHref } = Astro.props;
// Zet de echte foto in public/images/hero.jpg (1200x1500); dan verschijnt hij hier vanzelf.
const hasPhoto = existsSync('public/images/hero.jpg');
---
<section class="hero">
  <div class="wrap herogrid">
    <div class="reveal">
      <h1>{title}</h1>
      <p class="sub">{subtitle}</p>
      <div class="herobtns">
        <a class="btn btn-gold" href="#contact-teaser">{ctaPrimary}</a>
        <a class="btn btn-outline" href={ctaSecondaryHref}>{ctaSecondary}</a>
      </div>
      <slot />
    </div>
    <div class={`heroart reveal${hasPhoto ? ' has-photo' : ''}`} style="transition-delay:.15s">
      {hasPhoto && <img src="/images/hero.jpg" alt="Lodewijk Nortier en Arjan Nouwen, juristen in Den Haag" />}
      <div class="heroart-cap">
        <p class="heroart-names">Lodewijk Nortier &amp; Arjan Nouwen</p>
        <p>Juristen in Den Haag</p>
      </div>
    </div>
  </div>
</section>
