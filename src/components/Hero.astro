---
import { ui } from '../i18n/ui';
import { href, type Lang } from '../i18n';
interface Props { lang?: Lang; }
const { lang = 'nl' } = Astro.props;
const { title, subtitle, ctaPrimary, ctaSecondary, caption } = ui[lang].hero;
const ctaSecondaryHref = href(lang, '/diensten/');
---
<section class="hero">
  <div class="wrap herogrid">
    <div class="reveal">
      <h1>{title}</h1>
      <p class="sub">{subtitle}</p>
      <div class="herobtns">
        <a class="btn btn-gold" href="#contact-teaser">{ctaPrimary}</a>
        <a class="btn btn-outline" href={ctaSecondaryHref}>{ctaSecondary}</a>
      </div>
      <slot />
    </div>
    <!-- TODO: echte foto van Lodewijk en Arjan, 1200x1500, als <img> in .heroart -->
    <div class="heroart reveal" style="transition-delay:.15s">
      <div class="heroart-cap">
        <p class="heroart-names">Lodewijk Nortier &amp; Arjan Nouwen</p>
        <p>{caption}</p>
      </div>
    </div>
  </div>
</section>
