---
import { servicesFor } from '../i18n/services';
import { ui } from '../i18n/ui';
import { prefix, type Lang } from '../i18n';
import ServiceIcon from './ServiceIcon.astro';
interface Props { lang?: Lang; }
const { lang = 'nl' } = Astro.props;
const base = prefix(lang);
const t = ui[lang].servicesTeaser;
const services = servicesFor(lang);
---
<section class="block" id="diensten">
  <div class="wrap">
    <div class="sechead">
      <div>
        <h2>{t.title}</h2>
        <p>{t.sub}</p>
      </div>
    </div>
    <div class="grid3 reveal-stagger">
      {services.map((s) => (
        <div class="card">
          <ServiceIcon slug={s.slug} />
          <div class="body">
            <h3>{s.title}</h3>
            <p>{s.teaser}</p>
            <a class="readmore" href={`${base}/diensten/${s.slug}/`}>{t.readMore} &rarr;</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
