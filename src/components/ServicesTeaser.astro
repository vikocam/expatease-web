---
import { services } from '../data/services';
interface Props { lang?: 'nl' | 'en' | 'es' | 'fr'; }
const { lang = 'nl' } = Astro.props;
const base = lang === 'nl' ? '' : `/${lang}`;
// line icons (Phosphor, light weight) instead of emoji
import houseIcon from '@phosphor-icons/core/assets/light/house-line-light.svg?raw';
import handshakeIcon from '@phosphor-icons/core/assets/light/handshake-light.svg?raw';
import bankIcon from '@phosphor-icons/core/assets/light/bank-light.svg?raw';
const icons: Record<string, string> = { huurrecht: houseIcon, kooprecht: handshakeIcon, overheid: bankIcon };
const svg = (slug: string) => (icons[slug] ?? '').replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---
<section class="block" id="diensten">
  <div class="wrap">
    <div class="sechead">
      <div>
        <h2>Onze rechtsgebieden</h2>
        <p>Geschillen en advies in de privésfeer, voor particulieren. Geen arbeidsrecht.</p>
      </div>
    </div>
    <div class="grid3 reveal-stagger">
      {services.map((s) => (
        <div class="card">
          <div class="top svc-top">
            <span class="svc-icon" set:html={svg(s.slug)} />
            <span class="svc-mark" set:html={svg(s.slug)} />
          </div>
          <div class="body">
            <h3>{s.title}</h3>
            <p>{s.teaser}</p>
            <div class="testi"><span class="stars">★★★★★</span>{s.testimonial}</div>
            <a class="readmore" href={`${base}/diensten/${s.slug}/`}>Lees meer &rarr;</a>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
