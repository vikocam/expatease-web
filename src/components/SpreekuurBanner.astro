---
import ExpaTableMark from './ExpaTableMark.astro';
import calendarIcon from '@phosphor-icons/core/assets/light/calendar-dots-light.svg?raw';
import chatIcon from '@phosphor-icons/core/assets/light/chats-circle-light.svg?raw';
interface Props { lang?: 'nl' | 'en' | 'es' | 'fr'; }
const { lang = 'nl' } = Astro.props;
const base = lang === 'nl' ? '' : `/${lang}`;
const icon = (svg: string) => svg.replace('<svg ', '<svg aria-hidden="true" focusable="false" ');
---
<section class="xt-band" id="spreekuur" aria-labelledby="xt-band-title">
  <ExpaTableMark part="mark" />
  <div class="wrap xt-band-grid">
    <div class="xt-band-text reveal">
      <ExpaTableMark part="icon" />
      <p class="xt-kicker">Wekelijks inloopspreekuur</p>
      <h2 id="xt-band-title">ExpaTable</h2>
    </div>
    <div class="xt-band-side reveal" style="transition-delay:.12s">
      <ul class="xt-facts">
        <li><span set:html={icon(calendarIcon)} />Elke vrijdagmiddag</li>
        <li><span set:html={icon(chatIcon)} />Reactie binnen 24 uur</li>
      </ul>
      <a class="btn btn-gold" href={`${base}/spreekuur/`}>Meer over ExpaTable</a>
    </div>
  </div>
</section>

<style>
  .xt-band{
    position:relative;overflow:hidden;color:#f7f8fa;padding:64px 0;
    background:linear-gradient(140deg,var(--navy) 0%,var(--navy-light) 100%);
  }
  .xt-band-grid{position:relative;display:grid;grid-template-columns:1fr auto;gap:40px;align-items:end}
  @media (max-width:767px){
    .xt-band{padding:52px 0}
    .xt-band-grid{grid-template-columns:1fr;gap:28px;align-items:start}
  }
  .xt-kicker{margin:0 0 8px;color:#d6dfeb;font-weight:600;font-size:15px}
  .xt-band h2{margin:0;color:#f7f8fa;font-size:clamp(36px,4.6vw,54px);line-height:1;letter-spacing:-.02em}

  .xt-band-side{display:flex;flex-direction:column;gap:22px;align-items:flex-start}
  .xt-facts{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:12px}
  .xt-facts li{display:flex;align-items:center;gap:12px;font-size:17px;color:#f7f8fa}
  .xt-facts span{flex:none;width:28px;height:28px;color:var(--gold)}
  .xt-facts span :global(svg){width:100%;height:100%;display:block}
</style>
