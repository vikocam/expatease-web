---
interface Props { lang?: 'nl' | 'en' | 'es' | 'fr'; }
const { lang = 'nl' } = Astro.props;
const base = lang === 'nl' ? '' : `/${lang}`;
---
<section class="urgency" id="spreekuur">
  <div class="wrap urow reveal">
    <div><h3>ExpaTable</h3><p>Wekelijks inloopspreekuur, elke vrijdagmiddag van 14:00 tot 16:00 op het Plein. Reactie binnen 24 werkuren.</p></div>
    <a class="btn btn-gold" href={`${base}/spreekuur/`}>Meer over Spreekuur</a>
  </div>
</section>
