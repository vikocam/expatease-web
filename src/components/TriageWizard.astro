---
// Client-side interactive component. In Astro this is a plain island: all
// markup renders as static HTML, and the small script below hydrates on load
// without needing React/Vue — keeping the page at ~0kb JS framework cost.
import { ui } from '../i18n/ui';
import { href, type Lang } from '../i18n';
import { SHOW_WHATSAPP } from '../config';
interface Props { whatsappNumber?: string; lang?: Lang; }
const { whatsappNumber = '31600000000', lang = 'nl' } = Astro.props;
const t = ui[lang].wizard;
---
<div class="wizard" id="wizard" data-wa={whatsappNumber} data-intro={t.msgIntro} data-situation={t.msgSituation} data-urgency={t.msgUrgency}>
  <h3>{t.title}</h3>
  <p class="wsub">{t.sub}</p>
  <div class="wsteps"><span id="s1"></span><span id="s2"></span></div>

  <div class="wstep" data-step="1">
    <div class="pills">
      {t.topics.map((o) => <button class="pill" data-v={o.v}>{o.label}</button>)}
    </div>
  </div>
  <div class="wstep" data-step="2" style="display:none">
    <div class="pills">
      {t.urgency.map((o) => <button class={o.urgent ? 'pill pill-urgent' : 'pill'} data-v={o.v}>{o.label}</button>)}
    </div>
  </div>

  <div class="wresult" id="wresult">
    <strong>{t.thanks}</strong> {t.resultPre} <span id="rSituatie"></span>.
    <div style="margin-top:14px;display:flex;gap:12px;flex-wrap:wrap;align-items:center">
      {SHOW_WHATSAPP ? (
        <>
          <a class="btn" id="waResult" style="background:#25D366;color:#f7f5f0" target="_blank" rel="noopener" href="#">{t.waButton}</a>
          <a class="linkarrow" style="font-size:13px" href={href(lang, '/contact/')}>{t.emailLink} &rarr;</a>
        </>
      ) : (
        <a class="btn btn-gold" href={href(lang, '/contact/')}>{t.formButton}</a>
      )}
    </div>
    {SHOW_WHATSAPP && <p style="margin:10px 0 0;font-size:12px;color:var(--muted)">{t.prefilled}</p>}
  </div>
  <span class="wback" id="wback" style="display:none">&larr; {t.back}</span>
</div>

<script>
  (function () {
    const root = document.getElementById('wizard');
    if (!root) return;
    const waNumber = root.dataset.wa;
    const steps = [1, 2];
    const last = steps.length;
    let cur = 1;
    const answers: Record<number, string> = {};
    const dots: Record<number, HTMLElement> = {
      1: document.getElementById('s1')!,
      2: document.getElementById('s2')!,
    };
    function paintDots() {
      steps.forEach((n) => dots[n].classList.toggle('done', n <= cur - 1));
    }
    paintDots();

    document.querySelectorAll('.wstep').forEach((stepEl) => {
      stepEl.addEventListener('click', (e) => {
        const btn = (e.target as HTMLElement).closest('.pill') as HTMLElement | null;
        if (!btn) return;
        stepEl.querySelectorAll('.pill').forEach((p) => p.classList.remove('sel'));
        btn.classList.add('sel');
        const stepNum = Number((stepEl as HTMLElement).dataset.step);
        answers[stepNum] = btn.dataset.v || '';

        setTimeout(() => {
          if (stepNum < last) {
            (stepEl as HTMLElement).style.display = 'none';
            const next = document.querySelector(`.wstep[data-step="${stepNum + 1}"]`) as HTMLElement;
            next.style.display = 'block';
            cur = stepNum + 1;
            paintDots();
            document.getElementById('wback')!.style.display = 'inline-block';
          } else {
            document.querySelectorAll('.wstep').forEach((s) => ((s as HTMLElement).style.display = 'none'));
            document.getElementById('rSituatie')!.textContent = answers[1];
            const rawMsg = `${root.dataset.intro}\n- ${root.dataset.situation}: ${answers[1]}\n- ${root.dataset.urgency}: ${answers[2]}`;
            const waLink = document.getElementById('waResult') as HTMLAnchorElement | null;
            if (waLink) waLink.href = `https://wa.me/${waNumber}?text=${encodeURIComponent(rawMsg)}`;
            document.getElementById('wresult')!.classList.add('show');
            cur = last + 1;
            paintDots();
          }
        }, 180);
      });
    });

    document.getElementById('wback')!.addEventListener('click', () => {
      document.querySelectorAll('.wstep').forEach((s) => ((s as HTMLElement).style.display = 'none'));
      document.getElementById('wresult')!.classList.remove('show');
      (document.querySelector('.wstep[data-step="1"]') as HTMLElement).style.display = 'block';
      cur = 1;
      paintDots();
      document.getElementById('wback')!.style.display = 'none';
    });
  })();
</script>
