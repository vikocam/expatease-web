---
const reasons = [
  { title: 'Als je ons inhuurt, krijg je ons', text: 'Je dossier wordt nooit doorgestuurd. Je werkt rechtstreeks met Lodewijk of Arjan, van begin tot eind.' },
  { title: 'Lokale expertise in Haaglanden', text: 'Bekend met de bureaucratie in Den Haag, Delft, Rijswijk en omstreken.' },
  { title: 'Persoonlijk, geen callcenter', text: 'Je bericht wordt gelezen en beantwoord door een jurist, niet door een intake-team.' },
  { title: 'Meertalig toegankelijk', text: 'Advies in het Nederlands, Engels, Spaans en Frans.' },
];
---
<section class="why-section">
  <div class="wrap whylayout">
    <div class="why-intro reveal">
      <h2>Waarom ExpatEase</h2>
      <p>Geen anoniem kantoor. Twee juristen die je bij naam kennen, en die precies weten wat er komt kijken bij recht in een land dat niet het jouwe is.</p>
    </div>
    <div class="why-list reveal-stagger">
      {reasons.map((r) => (
        <div class="why-row">
          <h4>{r.title}</h4>
          <p>{r.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .why-section{background:var(--cream);border-top:1px solid var(--border);border-bottom:1px solid var(--border);padding:72px 0}
  /* intro stacked above a 2x2 grid; collapses to one column under 768px */
  .whylayout{display:grid;gap:40px}
  .why-intro h2{margin:0 0 12px;font-size:28px;color:var(--navy)}
  .why-intro p{margin:0;color:var(--muted);font-size:15.5px;max-width:58ch}
  .why-list{display:grid;grid-template-columns:repeat(2,1fr);gap:36px 56px}
  @media (max-width:767px){.why-list{grid-template-columns:1fr;gap:28px}}
  .why-row{border-top:2px solid var(--navy);padding-top:16px}
  .why-row h4{margin:0 0 6px;font-size:17px;color:var(--navy);font-weight:600}
  .why-row p{margin:0;font-size:14.5px;color:var(--muted);max-width:44ch}
</style>
