---
import SpreekuurView from '../../../views/SpreekuurView.astro';
import { langPaths, type Lang } from '../../../i18n';
import { SHOW_EXPATABLE } from '../../../config';
export const getStaticPaths = langPaths;
const lang = Astro.params.lang as Lang;
// without ExpaTable this page only sends visitors to the home page of the same link
const home = `/${lang}/`;
---
{SHOW_EXPATABLE ? <SpreekuurView lang={lang} /> : (
  <html lang={lang}><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><meta http-equiv="refresh" content={`0;url=${home}`} /><title>ExpatAid</title></head><body><a href={home}>ExpatAid</a></body></html>
)}
