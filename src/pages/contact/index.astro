---
import Layout from '../../layouts/Layout.astro';
import ContactBlock from '../../components/ContactBlock.astro';
---
<Layout
  title="Contact | ExpatEase Juridisch Adviesbureau"
  description="Neem contact op met ExpatEase voor juridisch advies in Den Haag en Regio Haaglanden."
  lang="nl"
  active="contact"
  path="/contact/"
>
  <section class="pagehero">
    <div class="wrap">
      <div class="breadcrumb"><a href="/">Home</a> / Contact</div>
      <h1>Neem contact op</h1>
      <p class="sub">We reageren binnen 24 werkuren, in jouw taal.</p>
    </div>
  </section>
  <ContactBlock title="Stuur ons een bericht" />
</Layout>
