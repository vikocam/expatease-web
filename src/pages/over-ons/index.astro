---
import Layout from '../../layouts/Layout.astro';
import BioCard from '../../components/BioCard.astro';
---
<Layout
  title="Over Ons — Lodewijk Nortier & Arjan Nouwen | ExpatEase"
  description="Maak kennis met Lodewijk Nortier en Arjan Nouwen, de juristen achter ExpatEase in Den Haag."
  lang="nl"
  active="over-ons"
  path="/over-ons/"
>
  <section class="pagehero">
    <div class="wrap">
      <div class="breadcrumb"><a href="/">Home</a> / Over Ons</div>
      <h1>Je vertrouwde team in Den Haag</h1>
      <p class="sub">Twee ervaren juristen, één doel: heldere rechtshulp voor internationals — geen anoniem kantoor, maar twee mensen die je bij naam kennen.</p>
    </div>
  </section>

  <section class="block">
    <div class="wrap" style="max-width:980px">
      <BioCard
        name="Lodewijk Nortier"
        initials="LN"
        role="Jurist — Internationale Oriëntatie"
        quote="Heldere taal is het beste wapen tegen bureaucratie."
        bio="Lodewijk is een ervaren jurist bij ExpatEase met een brede achtergrond in het civiele recht, de rechtsbijstandssector en de advocatuur. Hij onderscheidt zich door zijn praktische en resultaatgerichte aanpak en zijn vermogen om complexe juridische kwesties snel te analyseren en te vertalen naar werkbare oplossingen, steeds met oog voor de menselijke factor. Zijn internationale oriëntatie sluit nauw aan bij de expat-gerichte dienstverlening van ExpatEase. Lodewijk heeft een sterke affiniteit met Spaanse en Latijns-Amerikaanse culturen, spreekt vloeiend Spaans en begrijpt goed welke juridische uitdagingen internationals in Nederland ervaren."
        tags={["Civiel recht", "Vloeiend Spaans", "Internationale oriëntatie", "18+ jaar ervaring"]}
      />
      <BioCard
        name="Arjan Nouwen"
        initials="AN"
        role="Jurist — 20+ jaar ervaring"
        quote="Rust en duidelijkheid, juist als het spannend wordt."
        bio="Arjan is een gedreven en empathische jurist met ruim twintig jaar ervaring in de rechtspraktijk. Waar juridische vraagstukken voor cliënten vaak ingewikkeld of stressvol zijn, brengt Arjan rust en helderheid. Hij gelooft sterk in een persoonlijke aanpak waarin echt luisteren, toegankelijkheid en duidelijke communicatie centraal staan. Of het nu gaat om het schrijven van stukken, advisering of geschiloplossing — met zijn klantvriendelijke en betrokken werkwijze staat hij cliënten met deskundige én menselijke rechtshulp ter zijde."
        tags={["20+ jaar ervaring", "Persoonlijke aanpak", "Heldere communicatie", "Communiceert vlot met expats"]}
        reverse={true}
      />
    </div>
  </section>

  <section class="block alt">
    <div class="wrap" style="text-align:center">
      <h2>Liever meteen iemand spreken?</h2>
      <p class="sub" style="margin:0 auto 22px">Kom langs bij ons wekelijkse inloopspreekuur of stuur direct een bericht.</p>
      <div class="herobtns" style="justify-content:center">
        <a class="btn btn-gold" href="/spreekuur/">Bekijk het Spreekuur</a>
        <a class="btn btn-outline" href="/contact/">Contact</a>
      </div>
    </div>
  </section>
</Layout>
