---
{SHOW_EXPATABLE ? <SpreekuurView lang="nl" /> : (
  <html lang="nl"><head><meta charset="utf-8" /><meta name="robots" content="noindex" /><meta http-equiv="refresh" content={`0;url=${home}`} /><title>ExpatAid</title></head><body><a href={home}>ExpatAid</a></body></html>
)}
